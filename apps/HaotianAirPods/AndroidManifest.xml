<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.xiaomi.haotian.airpods">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.LOCAL_MAC_ADDRESS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="org.xiaomi.haotian.audio.permission.CONTROL_AUDIO" />

    <application
        android:name=".HaotianAirPodsApplication"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:icon="@mipmap/ic_airpods"
        android:label="@string/app_name"
        android:persistent="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive"
        android:usesNonSdkApi="true">

        <activity
            android:name=".AirPodsSettingsActivity"
            android:exported="true"
            android:permission="org.xiaomi.haotian.audio.permission.CONTROL_AUDIO">
            <intent-filter>
                <action android:name="org.xiaomi.haotian.airpods.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".AirPodsControlService"
            android:directBootAware="true"
            android:exported="false"
            android:singleUser="true" />

        <service
            android:name=".AirPodsHeadphoneProviderService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="org.xiaomi.haotian.audio.permission.BIND_HEADPHONE_PROVIDER"
            android:singleUser="true">
            <intent-filter>
                <action android:name="org.xiaomi.haotian.audio.action.HEADPHONE_POSE_PROVIDER" />
            </intent-filter>
        </service>

        <service
            android:name=".AirPodsMetadataService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:singleUser="true" />

        <service
            android:name=".HeadGestureService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".AirPodsNoiseControlTileService"
            android:directBootAware="true"
            android:exported="true"
            android:icon="@drawable/ic_airpods"
            android:label="@string/noise_control_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".HeadGestureReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AirPodsStateReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="org.xiaomi.haotian.audio.permission.CONTROL_AUDIO"
            android:singleUser="true">
            <intent-filter>
                <action android:name="org.xiaomi.haotian.airpods.action.STATE_CHANGED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.xiaomi.haotian.airpods.icons"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

    <string name="head_tracking_debug_angles_format">Rendering orientation\nYaw %1$+.1f° · pitch %2$+.1f° · roll %3$+.1f°\nNormalized quaternion: [%4$+.4f, %5$+.4f, %6$+.4f, %7$+.4f]</string>

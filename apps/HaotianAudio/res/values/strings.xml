    <string name="head_tracking_latency_title">Full-chain latency</string>
    <string name="head_tracking_latency_intro">Measurement starts when the AACP packet reaches Android. All stages use CLOCK_BOOTTIME. Output latency is reported by the audio path; the final acoustic value is an estimate, not a microphone measurement.</string>
    <string name="head_tracking_latency_overview_format">Estimated pose → acoustic output\n%1$s\nMeasured pose → effect callback %2$s · reported output %3$s\nPredictor look-ahead %4$d ms · compensation residual %5$s\n%6$s</string>
    <string name="head_tracking_latency_estimate_note">Positive residual means the predicted pose may still reach the ear late. Correlation has up to one pose-frame uncertainty.</string>
    <string name="head_tracking_latency_effect_tap_unavailable">The effect callback tap is unavailable, so end-to-end estimation is paused.</string>
    <string name="head_tracking_latency_stages_format">Measured stages\nAACP packet → normalized pose: %1$s\nDecoder → sink: %2$s\nShared-memory publish: %3$s\nPublish → Sensors HAL acquire: %4$s\nSensors HAL acquire → post: %5$s\nPose timestamp → effect callback: %6$s\nHAL sequence %7$d / producer %8$d</string>
    <string name="head_tracking_latency_output_format">Audio output\nCodec: %1$s\nCodec frame duration: %2$s\nMixer block: %3$s\nHAL/A2DP reported output latency: %4$s\nEffect callback age: %5$s</string>

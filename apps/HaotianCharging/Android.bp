android_app {
    name: "HaotianCharging",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    platform_apis: true,
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["vendor.lineage.powershare-V1-java"],
    optimize: {
        enabled: true,
    },
}

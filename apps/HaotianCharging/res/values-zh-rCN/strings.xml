<resources>
    <string name="app_name">MiCharge设定</string>
    <string name="page_summary">所有功能均由本机用户控制，不接受云控开启或锁定任何充电限制。</string>
    <string name="section_reverse">无线反向充电</string>
    <string name="reverse_title">无线反向充电</string>
    <string name="reverse_summary">使用手机为 Qi 配件充电；启用期间 NFC 会保持关闭，长时间未找到接收设备时由无线驱动自动停止。</string>
    <string name="reverse_threshold">低于此电量时停止</string>
    <string name="section_protection">电池保护</string>
    <string name="anti_aging_title">电池抗老化</string>
    <string name="anti_aging_summary">使用小米本地循环次数和电池健康策略。关闭后会停止服务并清除其浮充电压限制。</string>
    <string name="section_performance">充电行为</string>
    <string name="fast_charge_title">有线极速充电</string>
    <string name="fast_charge_summary">优先使用设备支持的最高有线充电速度，温控及硬件安全限制仍然有效。</string>
    <string name="wireless_mode_title">无线充电底座模式</string>
    <string name="wireless_mode_summary">通过小米无线协议控制兼容底座；温控与硬件安全限制始终有效。</string>
    <string name="wireless_mode_quiet">静音</string>
    <string name="wireless_mode_standard">标准</string>
    <string name="wireless_mode_boost">极速</string>
    <string name="bypass_title">手动旁路充电</string>
    <string name="bypass_summary">尽量直接为手机供电并减少给电池充电；拔线后自动关闭。</string>
    <string name="bypass_requirement">请先连接有线充电器并将电量充至至少 40%。</string>
    <string name="section_wireless_dock">无线充电底座</string>
    <string name="wireless_disable_nfc_title">无线充电时关闭 NFC</string>
    <string name="wireless_disable_nfc_summary">可选用于避免 NFC 与无线充电线圈相互干扰；仅当充电流程关闭过 NFC 时才会在结束后恢复。</string>

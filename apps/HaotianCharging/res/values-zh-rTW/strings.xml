<resources>
    <string name="app_name">MiCharge 設定</string>
    <string name="page_summary">所有功能均由本機使用者控制，不接受雲端控制啟用或鎖定任何充電限制。</string>
    <string name="section_reverse">無線反向充電</string>
    <string name="reverse_title">無線反向充電</string>
    <string name="reverse_summary">使用手機為 Qi 配件充電；啟用期間 NFC 會保持關閉，長時間未找到接收裝置時由無線驅動自動停止。</string>
    <string name="reverse_threshold">低於此電量時停止</string>
    <string name="section_protection">電池保護</string>
    <string name="anti_aging_title">電池抗老化</string>
    <string name="anti_aging_summary">使用小米本機循環次數與電池健康策略。關閉後會停止服務並清除其浮充電壓限制。</string>
    <string name="section_performance">充電行為</string>
    <string name="fast_charge_title">有線極速充電</string>
    <string name="fast_charge_summary">優先使用裝置支援的最高有線充電速度；溫控與硬體安全限制仍然有效。</string>
    <string name="wireless_mode_title">無線充電座模式</string>
    <string name="wireless_mode_summary">透過小米無線協定控制相容充電座；溫控與硬體安全限制始終有效。</string>
    <string name="wireless_mode_quiet">靜音</string>
    <string name="wireless_mode_standard">標準</string>
    <string name="wireless_mode_boost">極速</string>
    <string name="bypass_title">手動旁路充電</string>
    <string name="bypass_summary">儘量直接為手機供電並減少電池充電；拔線後自動關閉。</string>
    <string name="bypass_requirement">請先連接有線充電器並將電量充至至少 40%。</string>
    <string name="section_wireless_dock">無線充電座</string>
    <string name="wireless_disable_nfc_title">無線充電時關閉 NFC</string>
    <string name="wireless_disable_nfc_summary">可選用於避免 NFC 與無線充電線圈互相干擾；僅當充電流程關閉過 NFC 時才會在結束後恢復。</string>

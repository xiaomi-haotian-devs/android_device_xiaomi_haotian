<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.xiaomi.haotian.mibuds">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="org.xiaomi.haotian.audio.permission.OPEN_SETTINGS" />

    <permission
        android:name="org.xiaomi.haotian.mibuds.permission.CONTROL"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.xiaomi.haotian.mibuds.permission.CONTROL" />

    <application
        android:name=".HaotianMiBudsApplication"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:icon="@drawable/ic_mibuds"
        android:label="@string/app_name"
        android:persistent="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive"
        android:usesNonSdkApi="true">

        <activity
            android:name=".MiBudsSettingsActivity"
            android:exported="true"
            android:permission="org.xiaomi.haotian.mibuds.permission.CONTROL">
            <intent-filter>
                <action android:name="org.xiaomi.haotian.mibuds.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".MiBudsControlService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="org.xiaomi.haotian.mibuds.permission.CONTROL"
            android:singleUser="true" />

        <service
            android:name=".MiBudsHeadphoneProviderService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="org.xiaomi.haotian.audio.permission.BIND_HEADPHONE_PROVIDER"
            android:singleUser="true">
            <intent-filter>
                <action android:name="org.xiaomi.haotian.audio.action.HEADPHONE_POSE_PROVIDER" />
            </intent-filter>
        </service>

        <receiver
            android:name=".MiBudsBootReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED"
            android:singleUser="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

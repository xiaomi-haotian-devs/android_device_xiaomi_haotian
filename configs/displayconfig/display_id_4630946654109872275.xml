<?xml version='1.0' encoding='utf-8' standalone='yes' ?>

<displayConfiguration>
    <densityMapping>
        <density>
            <height>2400</height>
            <width>1080</width>
            <density>450</density>
        </density>
        <density>
            <height>3200</height>
            <width>1440</width>
            <density>600</density>
        </density>
    </densityMapping>
    <!-- Global Brightness-Nit mapping -->
    <screenBrightnessMap>
        <!--
            HyperOS starts the calibrated panel range at 0.000854597. AOSP requires every
            DisplayDeviceConfig map to also cover PowerManager.BRIGHTNESS_MIN (0.0), otherwise
            DisplayManager throws during boot. This compatibility anchor only covers the tiny
            range below the stock minimum; all stock calibration points remain unchanged.
        -->
        <point>
            <value>0.0</value>
            <nits>0.0</nits>
        </point>
        <point>
            <value>0.000854597</value>
            <nits>2.0</nits>
        </point>
        <point>
            <value>0.749847393</value>
            <nits>1800.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>3200.0</nits>
        </point>
    </screenBrightnessMap>
    <!-- root node for HBM-->
    <highBrightnessMode enabled="true">
        <!-- Transition point brightness from normal to HBM mode -->
        <transitionPoint>0.249963433</transitionPoint>
        <!-- Minimum lux to enter HBM -->
        <minimumLux>4475</minimumLux>
        <!-- Time limitation for HBM-->
        <timing>
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
        <!--Refresh rate limitation when the device is in HBM -->
        <!-- <refreshRate>
            <minimum>0</minimum>
            <maximum>0</maximum>
        </refreshRate> -->
        <!-- Thermal limitation for HBM -->
        <thermalStatusLimit>critical</thermalStatusLimit>
        <!-- Low power mode limitation for HBM -->
        <allowInLowPowerMode>true</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
            <point>
                <sdrNits>1800.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>
    <ambientLightHorizonLong>1500</ambientLightHorizonLong>
    <ambientLightHorizonShort>1000</ambientLightHorizonShort>
</displayConfiguration>

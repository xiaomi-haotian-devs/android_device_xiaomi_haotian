# Audio
ro.vendor.audio.A2H.cirrus=true
ro.vendor.audio.special.video.wnd_ns.type=3,C,0,1,1,2
ro.vendor.audio.voice.voip.holder.support=true

# Bluetooth
bluetooth.device.default_name=Xiaomi 15 Pro

# Display
debug.config.video.hevchdr10.encode.support=true
debug.video.recovery.killenable=true
persist.sys.miui_default_resolution=1440x3200
persist.sys.miui_resolution=1440,3200,600
persist.vendor.disable_idle_fps.threshold=0
persist.vendor.disable_idle_fps=false

# NFC
ro.vendor.se.type=eSE,HCE,UICC

persist.vendor.touchfeature.gameturbotool.version=v3.5
ro.vendor.fps.switch.default=true
ro.vendor.fps.switch.thermal=true
ro.vendor.display.dobly_dpu.enable=true
ro.vendor.display.primary_idle_refresh_rate=1,1:0
ro.vendor.display.switch_resolution.support=1
ro.vendor.display.uiservice_mafr.enable=true
ro.vendor.mi_sf.enable_automode_for_maxfps_setting=true
ro.vendor.mi_sf.enable_tp_idle_automode=true
ro.vendor.mi_sf.ltpo.support=true
ro.vendor.mi_sf.new_dynamic_refresh_rate=120,60:5
ro.vendor.mi_sf.skip_90hz_forVrrVote=true
ro.vendor.mi_sf.skip_promtionfps_for_90hz=true
ro.vendor.mi_sf.support_aidl_display_config=true
ro.vendor.mi_sf.support_automode_for_normalfps=true
ro.vendor.mi_sf.support_source_hdr_ProjectionScreen=true
ro.vendor.mi_sf.support_source_p3_ProjectionScreen=true
ro.vendor.mi_sf.supported_automode_maxfps_list=60,120
ro.vendor.touchfeature.type=183
vendor.display.enable_inline_writeback=0
vendor.display.enable_spec_fence=1
vendor.display.enable_spr=1
vendor.display.force_lm_to_fb_config=1
vendor.display.support_mafr_feature=1
vendor.mi_sf.enable_second_refresh_rate_overlay=1

# Camera
persist.vendor.camera.logentry=1
persist.vendor.camera.sdk.third.jpegr.enable=0

# Fingerprint
persist.vendor.fingerprint.type=udfps
persist.vendor.fingerprint.sensor_location=720|2502|92
persist.vendor.sys.fp.fod.location.X_Y=628,2410
persist.vendor.sys.fp.fod.size.width_height=184,184
persist.vendor.sys.fp.fod.us.target=616,2388,824,2616
ro.hardware.fp.fod.touch.ctl.version=2.0
ro.hardware.fp.fod=true
ro.hardware.fp.fod.c=true
ro.hardware.fp.mievent=true
ro.vendor.mi_sf.disable_mifod_flag=true

# Marketname
ro.product.marketname=Xiaomi 15 Pro

# USB
vendor.usb.product_string=Xiaomi 15 Pro

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
         Xiaomi Account otherwise waits forever for HyperOS Find Device's
         miui.sedc Binder.  The device service reports hardware FID signing as
         unsupported so AccountSDK can use its existing no-FID fallback.
    -->
    <string-array name="config_deviceSpecificSystemServices" translatable="false">
        <item>com.android.server.haotian.MiuiSedcCompatService</item>
        <item>com.android.server.haotian.XiaomiDisplayFeatureService</item>
        <item>com.android.server.haotian.XiaomiWirelessChargingService</item>
    </string-array>

    <!-- Stock ufs_qcom exposes Xiaomi's read-only Extended User Area status here. -->
    <string name="config_primaryStorageExtensionSysfsPath" translatable="false">/sys/devices/platform/soc/1d84000.ufshc/ufseua</string>

    <!-- The stock panel pipeline consumes Xiaomi DisplayFeature commands and both physical ALSes. -->
    <bool name="config_xiaomiDisplayFeatureAvailable">true</bool>
    <bool name="config_xiaomiDualLightSensorAvailable">true</bool>
    <bool name="config_xiaomiDynamicRefreshRateAvailable">true</bool>
    <bool name="config_disableRefreshRateThermalThrottling">true</bool>

    <!-- Xiaomi EyeCare/TrueTone own the panel color temperature; do not stack Night Display. -->
    <bool name="config_nightDisplayAvailable">false</bool>

    <!-- Use HyperOS-style, independently configurable hardware-key shortcuts. -->
    <bool name="config_deviceKeyShortcutsEnabled">true</bool>
    <integer name="config_doubleTapPowerGestureMode">0</integer>

    <!-- HyperOS retains 150 media indices and moves ten indices per volume-key press. -->
    <integer name="config_audio_music_vol_key_step">10</integer>

    <!-- The Qualcomm UIM stack retains ISD-R on channel 1 for removable eUICCs. -->
    <integer name="config_euiccModemOwnedChannel">1</integer>

    <!-- Stock haotian center punch-hole safe geometry at 1440x3200, in physical pixels. -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M 0,0 H -40.5 V 169 H 40.5 V 0 H 0 Z</string>

    <!--
         The stock AIDL fingerprint HAL reports the UDFPS at (720, 2502) with
         a 92px radius. Keep config_udfps_sensor_props unset so that the HAL is
         the single source of truth and scales the sensor for lower resolutions.
    -->

    <!--
         Do not fall back to the framework's legacy integer minimum (10/255).
         BrightnessSynchronizer converts that value to 0.035433, which clips the
         first two points from haotian's physical brightness map and raises the
         panel minimum from 0.2289 nit to about 6.41 nit.
    -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.0</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>


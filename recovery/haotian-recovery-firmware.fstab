# QSEE trustlets are stored in the active modem firmware partition. Recovery mounts it read-only;
# vendor/product/system dynamic partitions remain unmounted and free for OTA processing.
/dev/block/by-name/modem /vendor/firmware_mnt vfat ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait,slotselect

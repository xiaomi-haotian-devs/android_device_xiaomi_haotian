hal_attribute(miface)

type hal_miface_default, domain;
type hal_miface_default_exec, exec_type, vendor_file_type, file_type;
type hal_miface_service, hal_service_type, service_manager_type;

init_daemon_domain(hal_miface_default)
binder_use(hal_miface_default)
hal_server_domain(hal_miface_default, hal_face)
hal_server_domain(hal_miface_default, hal_miface)
hal_attribute_service(hal_miface, hal_miface_service)
hal_client_domain(hal_miface_default, hal_graphics_allocator)

# Standard face storage and the MiTEE client devices.
allow hal_miface_default face_vendor_data_file:dir create_dir_perms;
allow hal_miface_default face_vendor_data_file:file create_file_perms;
allow hal_miface_default mitee_client_device:chr_file rw_file_perms;

# Protected front-camera enrollment/authentication and gralloc buffers.
allow hal_miface_default cameraserver:binder { call transfer };
allow cameraserver hal_miface_default:binder transfer;
allow hal_miface_default cameraserver:fd use;
allow hal_miface_default fwk_camera_service:service_manager find;
allow hal_miface_default fwk_camera_hwservice:hwservice_manager find;
allow hal_miface_default hal_graphics_allocator_default:binder { call transfer };
allow hal_graphics_allocator_default hal_miface_default:binder transfer;
allow hal_miface_default hal_graphics_allocator_default:fd use;
allow hal_miface_default hal_graphics_allocator_default_tmpfs:file rw_file_perms;
allow hal_miface_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_miface_default hal_graphics_mapper_service:service_manager find;
allow hal_miface_default hidl_token_hwservice:hwservice_manager find;
allow hal_miface_default fwk_sensor_hwservice:hwservice_manager find;

# Secure-camera/MiTEE shared memory transport.
allow hal_miface_default vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow hal_miface_default vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;
allow hal_miface_default vendor_membuf_dev:chr_file r_file_perms;
allowxperm hal_miface_default vendor_membuf_dev:chr_file ioctl { 0x4d05 };
allow hal_miface_default self:qipcrtr_socket create_socket_perms_no_ioctl;

# Display/FOD state and device capability properties used by the stock HAL.
allow hal_miface_default sysfs_tp_fodstatus:{ file chr_file } r_file_perms;
allow hal_miface_default vendor_sysfs_displayfeature:file r_file_perms;
get_prop(hal_miface_default, camera_config_prop)
get_prop(hal_miface_default, vendor_display_prop)
get_prop(hal_miface_default, vendor_fp_prop)
get_prop(hal_miface_default, vendor_radio_prop)
get_prop(hal_miface_default, vendor_mitee_prop)
set_prop(hal_miface_default, vendor_miface_prop)
